# Server Port (Render sets this automatically, default 5000)
PORT=5000

# Frontend Client URL for CORS (e.g. your Vercel URL)
CLIENT_URL=https://your-project.vercel.app

# MongoDB Connection String (MongoDB Atlas M0 Free Tier)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/sunvolt?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/sunvolt?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=sunvolt_super_secret_jwt_key_2026_solar_energy_enterprise

# Default Admin Credentials
ADMIN_EMAIL=admin@sunvolt.com
ADMIN_PASSWORD=Admin@Sunvolt2026!
