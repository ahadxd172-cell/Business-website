# Server Port
PORT=5000

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/sunvolt
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sunvolt?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/sunvolt
